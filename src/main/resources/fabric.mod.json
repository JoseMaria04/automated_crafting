{
  "schemaVersion": 1,
  "id": "automated_crafting",
  "version": "${version}",

  "name": "Automated Crafting",
  "description": "Adds a simple autocrafter block. Has a simple mode and a... not simple mode.\nUnofficial 26.3 port by JoseMaria04 of the original mod by supersaiyansubtlety.",
  "authors": [
    "supersaiyansubtlety"
  ],
  "contributors": [
    "JoseMaria04 (26.3 port)"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/automated-crafting",
    "sources": "https://github.com/JoseMaria04/automated_crafting",
    "issues": "https://github.com/JoseMaria04/automated_crafting/issues"
  },

  "license": "MIT",
  "icon": "assets/automated_crafting/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.sssubtlety.automated_crafting.Init"
    ],
    "client": [
      "net.sssubtlety.automated_crafting.ClientInit"
    ]
  },
  "mixins": [
    "automated_crafting.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "~26.3"
  }
}
